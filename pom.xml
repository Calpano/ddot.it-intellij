<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.calpano.ddot</groupId>
    <artifactId>ddot.it-intellij</artifactId>
    <version>0.1.3</version>
    <packaging>jar</packaging>

    <name>ddot.it IntelliJ Plugin</name>
    <description>Authoring support for ddot.it — a minimal notation for knowledge graphs.</description>

    <!--
        BUILD MODEL.
        JetBrains only publishes the IDE as a zip artifact (no individual platform jars
        on Maven Central / JetBrains-releases). We download that zip with the
        maven-dependency-plugin, unpack its top-level jars into target/idea-lib at the
        `initialize` phase, and reference each jar as a system-scoped dependency. This
        is the same model CLI Maven and IntelliJ's JPS build both use — there is no
        compilerArgs `-classpath` override to interfere with IntelliJ's auto-classpath.

        Fresh-checkout bootstrap (one time):
          mvn -N initialize
          mvn package

        After that, `mvn package` works in one step. `mvn clean` preserves
        target/idea-lib (configured below), so the 1.5 GB unpack isn't redone
        on every clean build.
    -->

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>

        <!-- IntelliJ IDEA Community baseline. Update to retarget. -->
        <intellij.version>2024.2</intellij.version>

        <!-- graphinout: provides the canonical Connected JSON (CJ) -> ddot.it mapping
             (com.graphinout.base.cj.document.CjDocuments + reader-ddot's DDotOutput).
             reader-ddot pulls in `base` and the whole conversion stack transitively. -->
        <graphinout.version>0.1.14</graphinout.version>
        <idea.lib.dir>${project.build.directory}/idea-lib</idea.lib.dir>
        <verifier.version>1.402</verifier.version>
        <verifier.ide.path>/Applications/IntelliJ IDEA.app/Contents</verifier.ide.path>

        <!--
            Cross-implementation golden corpus shared between this project and
            the Ruby renderer in ../ddot.it/. Tests under PreviewHtmlGoldenTest
            walk this directory; if it isn't present (e.g. fresh CI checkout
            of just this repo) the test logs a warning and passes vacuously
            instead of failing. Override on the command line:
              mvn test -Dddot.test-data.dir=/abs/path/to/test-data
        -->
        <ddot.test-data.dir>${project.basedir}/../ddot.it/test-data</ddot.test-data.dir>
    </properties>

    <repositories>
        <repository>
            <id>jetbrains-intellij-releases</id>
            <name>JetBrains IntelliJ Releases</name>
            <url>https://www.jetbrains.com/intellij-repository/releases</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <!--
        Force one consistent jackson version across the graphinout stack. graphinout
        pins jackson-annotations to 2.20 (foundation-jvm) while jackson-databind floats
        to 2.21.2; databind 2.21 references com.fasterxml.jackson.annotation.JsonSerializeAs
        which only exists in annotations 2.21, so the mismatch crashes ObjectMapper init
        with ClassNotFoundException. The BOM aligns annotations/core/databind to 2.21.2.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>2.21.2</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
        Every dependency below is the unpacked IntelliJ platform's jars. The unpack
        runs at `initialize` phase, before dependency resolution kicks in for `compile`,
        so on a fresh checkout `mvn package` works in one step. After a `mvn clean`,
        target/idea-lib survives (see maven-clean-plugin config).

        Regenerate the list after bumping <intellij.version>:
          mvn -N initialize
          ls target/idea-lib/*.jar | sort | while read j; do
            b=$(basename "$j" .jar)
            printf '        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>%s</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/%s.jar</systemPath></dependency>\n' "$b" "$b"
          done
    -->
    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>

        <!--
            Connected JSON -> ddot.it conversion. Real (non-system) Maven dependency:
            its classes + transitives (jackson, guava, joni, json-schema-validator, …)
            are bundled into the plugin jar by the maven-shade-plugin below, with the
            IDE-clashing libraries relocated. slf4j-api is excluded from the shaded jar
            (the IntelliJ platform supplies the binding).
        -->
        <dependency>
            <groupId>com.graphinout</groupId>
            <artifactId>reader-ddot</artifactId>
            <version>${graphinout.version}</version>
            <exclusions>
                <!--
                    foundation-emulation ships STRIPPED-DOWN copies of third-party
                    classes (e.g. a jackson JsonIdentityInfo without resolver()/
                    generator()) for j2cl/GWT. On the JVM they shadow the real
                    libraries and cause NoSuchMethodError. foundation-jvm excludes
                    it for the same reason; the real jackson-annotations comes in
                    via base/foundation-jvm.
                -->
                <exclusion>
                    <groupId>com.graphinout</groupId>
                    <artifactId>foundation-emulation</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>annotations</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/annotations.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>app-client</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/app-client.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>app</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/app.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>bouncy-castle</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/bouncy-castle.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>external-system-rt</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/external-system-rt.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>externalProcess-rt</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/externalProcess-rt.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>forms_rt</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/forms_rt.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>groovy</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/groovy.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>idea_rt</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/idea_rt.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij-test-discovery</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij-test-discovery.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.ide.startup.importSettings</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.ide.startup.importSettings.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.idea.customization.base</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.idea.customization.base.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.kotlin.onboarding-promoter</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.kotlin.onboarding-promoter.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.libraries.ktor.client</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.libraries.ktor.client.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.libraries.microba</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.libraries.microba.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.platform.clouds</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.platform.clouds.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.platform.collaborationTools</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.platform.collaborationTools.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.platform.coverage.agent</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.platform.coverage.agent.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.platform.coverage</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.platform.coverage.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.platform.execution.dashboard</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.platform.execution.dashboard.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.platform.execution.serviceView</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.platform.execution.serviceView.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.platform.experiment</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.platform.experiment.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.platform.ide.newUiOnboarding</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.platform.ide.newUiOnboarding.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.platform.images.backend.svg</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.platform.images.backend.svg.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.platform.images.copyright</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.platform.images.copyright.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.platform.kernel.backend</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.platform.kernel.backend.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.platform.kernel</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.platform.kernel.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.platform.lvcs.impl</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.platform.lvcs.impl.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.platform.ml.embeddings</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.platform.ml.embeddings.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.platform.navbar.backend</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.platform.navbar.backend.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.platform.navbar.frontend</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.platform.navbar.frontend.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.platform.navbar</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.platform.navbar.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.platform.navbar.monolith</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.platform.navbar.monolith.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.platform.settings.local</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.platform.settings.local.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.platform.smRunner.vcs</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.platform.smRunner.vcs.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.platform.vcs.dvcs.impl</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.platform.vcs.dvcs.impl.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.platform.vcs.impl</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.platform.vcs.impl.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.platform.vcs.log.impl</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.platform.vcs.log.impl.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.smart.update</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.smart.update.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>intellij.xml.xmlbeans</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/intellij.xml.xmlbeans.jar</systemPath></dependency>
        <!-- Bundled JSON plugin jar (plugins/json/lib/json.jar), unpacked into idea-lib.
             Provides com.intellij.json.JsonLanguage / JsonFileType for CjJsonFileType.
             Compile-time only; the runtime jar comes from the user's IDE. -->
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>json</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/json.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>jps-model</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/jps-model.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>jsch-agent</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/jsch-agent.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>junit4</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/junit4.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>lib-client</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/lib-client.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>lib</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/lib.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>markdown</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/markdown.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>nio-fs</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/nio-fs.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>opentelemetry</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/opentelemetry.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>platform-loader</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/platform-loader.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>protobuf</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/protobuf.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>rd</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/rd.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>stats</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/stats.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>testFramework</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/testFramework.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>trove</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/trove.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>util_rt</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/util_rt.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>util-8</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/util-8.jar</systemPath></dependency>
        <dependency><groupId>com.jetbrains.intellij.local</groupId><artifactId>util</artifactId><version>${intellij.version}</version><scope>system</scope><systemPath>${idea.lib.dir}/util.jar</systemPath></dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>

        <plugins>
            <!--
                Preserve target/idea-lib across `mvn clean` so we don't repeat
                the 1.5 GB unpack on every clean build, and so the system-scoped
                dependencies above keep resolving on the next build.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <excludeDefaultDirectories>true</excludeDefaultDirectories>
                    <filesets>
                        <fileset>
                            <directory>${project.build.directory}</directory>
                            <excludes>
                                <exclude>idea-lib/**</exclude>
                            </excludes>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.7.0</version>
                <executions>
                    <execution>
                        <id>unpack-idea</id>
                        <phase>initialize</phase>
                        <goals><goal>unpack</goal></goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.jetbrains.intellij.idea</groupId>
                                    <artifactId>ideaIC</artifactId>
                                    <version>${intellij.version}</version>
                                    <type>zip</type>
                                    <outputDirectory>${idea.lib.dir}</outputDirectory>
                                    <!--
                                        The ideaIC zip is rooted directly at lib/
                                        (no version-wrapper directory), so the glob is
                                        lib/*.jar — NOT **/lib/*.jar. Avoid the broader
                                        glob: it also grabs plugin libs like
                                        plugins/Groovy/lib/Groovy.jar, which collides
                                        case-insensitively with the top-level
                                        lib/groovy.jar on macOS APFS.
                                    -->
                                    <!--
                                        Bundled-plugin jars we need on the compile classpath:
                                        - plugins/markdown/lib/markdown.jar
                                          for org.intellij.plugins.markdown.injection.CodeFenceLanguageProvider,
                                          which the Markdown plugin's CodeFenceInjector consults to map
                                          fence info strings (`ddot`, `ddot.it`, `ddotit`) to DdotLanguage.
                                          Compile-time only; the runtime jar comes from the user's IDE.
                                    -->
                                    <includes>lib/*.jar,lib/modules/*.jar,plugins/markdown/lib/markdown.jar,plugins/json/lib/json.jar</includes>
                                    <fileMappers>
                                        <org.codehaus.plexus.components.io.filemappers.FlattenFileMapper/>
                                    </fileMappers>
                                </artifactItem>
                            </artifactItems>
                            <overWriteSnapshots>false</overWriteSnapshots>
                            <overWriteReleases>false</overWriteReleases>
                            <overWriteIfNewer>false</overWriteIfNewer>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <systemPropertyVariables>
                        <ddot.test-data.dir>${ddot.test-data.dir}</ddot.test-data.dir>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!--
                Bundle graphinout + its transitives into the plugin jar. The libraries
                the IntelliJ platform also ships (guava, jackson, commons-io) are
                RELOCATED so the plugin uses graphinout's own versions instead of the
                IDE's older ones; slf4j-api is dropped entirely so logging routes
                through the platform's binding (graphinout's logback was demoted to
                test scope upstream, so it never reaches here). Libraries the platform
                does NOT ship (joni, json-schema-validator, elemental2, …) are bundled
                as-is — no conflict to avoid.

                Runs in `package` after maven-jar-plugin (declared above) and before
                maven-assembly-plugin (declared below), so the assembly zips the
                shaded jar.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <artifactSet>
                                <excludes>
                                    <!-- Provided by the IntelliJ platform; never bundle. -->
                                    <exclude>org.slf4j:slf4j-api</exclude>
                                    <!-- System-scoped IDE jars (belt-and-suspenders; shade skips system scope). -->
                                    <exclude>com.jetbrains.intellij.local:*</exclude>
                                </excludes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>com.google.common</pattern>
                                    <shadedPattern>com.calpano.ddot.shaded.com.google.common</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.google.thirdparty</pattern>
                                    <shadedPattern>com.calpano.ddot.shaded.com.google.thirdparty</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.fasterxml.jackson</pattern>
                                    <shadedPattern>com.calpano.ddot.shaded.com.fasterxml.jackson</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.apache.commons.io</pattern>
                                    <shadedPattern>com.calpano.ddot.shaded.org.apache.commons.io</shadedPattern>
                                </relocation>
                            </relocations>
                            <transformers>
                                <!-- Merge (and relocate) META-INF/services so jackson module SPI keeps working. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                        <!--
                                            Drop multi-release versioned classes. shade does not relocate
                                            them consistently (it leaves them under the original package
                                            path while rewriting references), and since the shaded jar's
                                            manifest is NOT marked Multi-Release the JVM never loads them
                                            anyway — it uses the relocated Java-8 base classes, which are
                                            complete. Keeping them only produces phantom NoSuchFieldError
                                            findings in the plugin verifier (jackson's FastDoubleParser).
                                        -->
                                        <exclude>META-INF/versions/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <configuration>
                    <descriptors>
                        <descriptor>src/assembly/plugin-zip.xml</descriptor>
                    </descriptors>
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>plugin-zip</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>

        <!--
            Run the JetBrains plugin verifier against the packaged plugin zip.
                mvn -Pverify verify
            Override the IDE under test:
                mvn -Pverify -Dverifier.ide.path=/path/to/IDE/Contents verify
        -->
        <profile>
            <id>verify</id>
            <dependencies>
                <!-- test scope (not runtime) so the maven-shade-plugin does NOT try to
                     bundle this fat verifier jar into the plugin. Declared only so Maven
                     downloads it to the local repo; exec:exec below runs it from there in
                     an isolated JVM (NOT exec:java — in-process would mix the verifier's
                     own jackson with the plugin's shaded graphinout jackson and crash). -->
                <dependency>
                    <groupId>org.jetbrains.intellij.plugins</groupId>
                    <artifactId>verifier-cli</artifactId>
                    <version>${verifier.version}</version>
                    <classifier>all</classifier>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <execution>
                                <id>verify-plugin</id>
                                <phase>verify</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>java</executable>
                                    <!-- Isolated classpath: ONLY the self-contained verifier
                                         "all" jar, never the project's dependencies. -->
                                    <arguments>
                                        <argument>-cp</argument>
                                        <argument>${settings.localRepository}/org/jetbrains/intellij/plugins/verifier-cli/${verifier.version}/verifier-cli-${verifier.version}-all.jar</argument>
                                        <argument>com.jetbrains.pluginverifier.PluginVerifierMain</argument>
                                        <argument>check-plugin</argument>
                                        <argument>${project.build.directory}/${project.artifactId}-${project.version}.zip</argument>
                                        <argument>${verifier.ide.path}</argument>
                                        <argument>-verification-reports-dir</argument>
                                        <argument>${project.build.directory}/verifier-reports</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
