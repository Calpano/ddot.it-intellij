<idea-plugin>
    <!--
        Loaded only when the JetBrains Markdown plugin (org.intellij.plugins.markdown)
        is installed. Registers a CodeFenceLanguageProvider that maps the fence
        info strings `ddot`, `ddot.it`, and `ddotit` to DdotLanguage. The Markdown
        plugin's own CodeFenceInjector consults registered providers and injects
        the resolved language into the fence body, giving us highlighting,
        completion, formatting, rename, etc. inside Markdown fenced code blocks.
    -->
    <extensions defaultExtensionNs="org.intellij.markdown">
        <fenceLanguageProvider
                implementation="com.calpano.ddot.injection.DdotMarkdownFenceProvider"/>
    </extensions>
</idea-plugin>
