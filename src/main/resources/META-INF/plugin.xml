<idea-plugin>
    <!-- ============================================================
         Identity. <id> is permanent — Marketplace uses it as the URL
         slug and the install key; never rename. <name> is the display
         string shown in the IDE plugin list AND the "plugins suggested
         for this file type" balloon when an unknown .ddot file opens.
         ============================================================ -->
    <id>com.calpano.ddot</id>
    <name>ddot.it</name>
    <version>0.1.0</version>
    <vendor url="https://ddot.it">ddot.it by Calpano</vendor>

    <!-- IDE compatibility range. Matches pom.xml `intellij.version=2024.2`.
         Update on retarget; otherwise users on newer IDEs get an "incompatible"
         banner instead of a broken install. -->
    <idea-version since-build="242" until-build="261.*"/>

    <description><![CDATA[
        <p>Authoring support for <a href="https://ddot.it">ddot.it — Knowledge Graph Notation</a>, a minimal text format
        for typed knowledge graphs. Each line is a triple —
        <code>subject ..predicate.. object</code> — written with double-dot separators.</p>
        <ul>
            <li>Syntax highlighting for <code>.ddot</code> files.</li>
            <li>Smart, slot-aware completion (subject / predicate / object) with auto-popup
                on continuation lines.</li>
            <li>Code folding per subject scope</li>
            <li>Structure view for subjects.</li>
            <li>Canonical formatter — <code>Reformat Code</code> (⌘⌥L) normalizes spacing.</li>
            <li>Rename refactoring (Shift+F6) renames every occurrence in the file.</li>
            <li>Find Usages (Alt+F7) on any entity.</li>
            <li>Live templates: <code>ddot-typed</code>, <code>ddot-link</code>,
                <code>ddot-property</code>, <code>ddot-continue</code>, <code>ddot-meta</code>.</li>
            <li>Tools menu: <i>Format Document</i>, <i>Export as JSON</i> — emits JSONL
                events matching the
                <a href="https://ddot.it/developer-guide.html#events">ddot.it event spec</a>
                next to the source file.</li>
        </ul>
    ]]></description>

    <change-notes><![CDATA[
        <h3>0.1.0</h3>
        <ul>
            <li>AsciiDoc preview support for ddot blocks. New Tools menu action
                <i>Install AsciiDoc Preview Extension</i> drops a Ruby
                AsciidoctorJ extension into <code>&lt;project&gt;/.asciidoctor/lib/</code>;
                <code>[ddot]</code>, <code>[ddotit]</code> and
                <code>[source,ddot|ddot.it|ddotit]</code> blocks then render
                with the same role coloring as the editor and the Markdown
                preview, with titles, ids and roles preserved on the block.</li>
            <li>Rouge lexer for ddot.it shipped alongside the extension —
                set <code>:source-highlighter: rouge</code> in your
                <code>.adoc</code> and <code>[source,ddot]</code> blocks
                dispatch through the standard Asciidoctor highlighter
                pipeline against the canonical token vocabulary
                (<a href="https://github.com/calpano/ddot.it/blob/main/test-data/tokens.md">tokens.md</a>).</li>
            <li>Cross-implementation golden corpus at
                <code>ddot.it/test-data/cases/</code> — every case has
                <code>expected.body.html</code>, <code>expected.events.jsonl</code>
                and <code>expected.tokens.json</code>, asserted byte-equal by
                the Java preview renderer, the JSONL exporter, the Ruby
                preview renderer (canonical), and the Rouge / TextMate
                highlighters.</li>
            <li>Fixes: continuation lines (<code>..pred.. obj</code>) now
                colour <code>pred</code> as the predicate, not the object
                (slot-advance bug); installed <code>.rb</code> files are now
                stamped with the plugin version on the first line so stale
                installs are easy to spot
                (<code>head -1 .asciidoctor/lib/ddot-extension.rb</code>).</li>
        </ul>
        <h3>0.0.9</h3>
        <ul>
            <li>Embed ddot.it inside Markdown fenced code blocks
                (<code>```ddot</code>, <code>```ddot.it</code>, <code>```ddotit</code>)
                and AsciiDoc listing blocks
                (<code>[source,ddot]</code>, <code>[ddot.it]</code>, …).
                Highlighting, completion, formatting, rename and find-usages
                all work inside the embedded fragment.</li>
            <li>Honour <code>ddot.it/off</code> and <code>ddot.it/on</code>: lines
                inside an off span are dimmed in the editor, collapsible as a
                fold, hidden from the structure view, and skipped by the
                <i>Export as JSON</i> action.</li>
            <li>Markdown preview: <code>```ddot</code> fences now render with the
                same role-aware coloring (subject / predicate / object / metadata /
                command) as the editor, tracking the active color scheme.</li>
        </ul>
        <h3>0.0.8</h3>
        <ul>
            <li>Minor change in logging.</li>
        </ul>
        <h3>0.0.7</h3>
        <ul>
            <li>Refactor away from deprecated IntelliJ APIs.</li>
            <li>Annotator now logs identifying context (file path, element class, range,
                text snippet) when it fails.</li>
        </ul>
        <h3>0.0.6 — Initial Marketplace Release</h3>
        <ul>
            <li>Real PSI, formatter, folding, structure view, completion, JSONL export.</li>
            <li>Rename refactoring: Shift+F6 on an entity renames every
                occurrence in the file.</li>
            <li>Auto-popup of continuation predicates after pressing Enter
                on a complete triple.</li>
        </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>

    <!-- ============================================================
         Optional integrations — load only when the host plugin is
         installed. Each config-file registers an extension that lets
         users embed ddot.it inside that host's code blocks: a Markdown
         fenced block opened with three backticks and "ddot", or an
         AsciiDoc listing block introduced by [source,ddot] and a row
         of dashes.
         ============================================================ -->
    <depends optional="true" config-file="ddot-markdown.xml">org.intellij.plugins.markdown</depends>
    <depends optional="true" config-file="ddot-asciidoc.xml">org.asciidoctor.intellij.asciidoc</depends>

    <!-- ============================================================
         Language registration. The `extensions="ddot"` attribute is what
         makes Marketplace's "plugin suggested for this file type" balloon
         fire when a user opens a .ddot file with no plugin installed.
         ============================================================ -->
    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="ddot.it"
                implementationClass="com.calpano.ddot.DdotFileType"
                fieldName="INSTANCE"
                language="ddot.it"
                extensions="ddot"/>

        <lang.parserDefinition
                language="ddot.it"
                implementationClass="com.calpano.ddot.parser.DdotParserDefinition"/>

        <lang.syntaxHighlighterFactory
                language="ddot.it"
                implementationClass="com.calpano.ddot.highlighting.DdotSyntaxHighlighterFactory"/>

        <colorSettingsPage
                implementation="com.calpano.ddot.highlighting.DdotColorSettingsPage"/>

        <!-- Positional syntax highlighting (subject/predicate/object/meta/command). -->
        <annotator
                language="ddot.it"
                implementationClass="com.calpano.ddot.highlighting.DdotHighlightAnnotator"/>

        <lang.foldingBuilder
                language="ddot.it"
                implementationClass="com.calpano.ddot.folding.DdotFoldingBuilder"/>

        <lang.psiStructureViewFactory
                language="ddot.it"
                implementationClass="com.calpano.ddot.structure.DdotStructureViewFactory"/>

        <completion.contributor
                language="ddot.it"
                implementationClass="com.calpano.ddot.completion.DdotCompletionContributor"/>

        <formattingService
                implementation="com.calpano.ddot.formatter.DdotFormattingService"/>

        <lang.documentationProvider
                language="ddot.it"
                implementationClass="com.calpano.ddot.documentation.DdotDocumentationProvider"/>

        <!-- Live templates contributed under the DDOT context (file type ddot.it). -->
        <defaultLiveTemplates file="/liveTemplates/ddot.xml"/>
        <liveTemplateContext
                contextId="DDOT"
                implementation="com.calpano.ddot.DdotTemplateContextType"/>

        <!-- Rename + Find Usages plumbing. -->
        <lang.elementManipulator
                forClass="com.calpano.ddot.psi.DdotEntity"
                implementationClass="com.calpano.ddot.psi.DdotEntityManipulator"/>

        <renamePsiElementProcessor
                implementation="com.calpano.ddot.refactoring.DdotEntityRenameProcessor"/>

        <lang.findUsagesProvider
                language="ddot.it"
                implementationClass="com.calpano.ddot.refactoring.DdotFindUsagesProvider"/>
    </extensions>

    <!-- ============================================================
         Auto-popup completion: a document edit that inserts a newline
         arms a flag; the next caret-change schedules an autopopup if the
         cursor is on a fresh continuation line. Listener is attached
         only to ddot.it editors, freed on editor release.
         ============================================================ -->
    <applicationListeners>
        <listener
                class="com.calpano.ddot.completion.DdotAutoPopupRegistrar"
                topic="com.intellij.openapi.editor.event.EditorFactoryListener"/>
    </applicationListeners>

    <!-- ============================================================
         Tools menu group. (No Validate action — ddot.it cannot be invalid.)
         ============================================================ -->
    <actions>
        <group id="DdotActions" text="ddot.it" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action
                    id="Ddot.Format"
                    class="com.calpano.ddot.actions.FormatAction"
                    text="Format Document"
                    description="Format the current ddot.it document"/>
            <action
                    id="Ddot.ExportJson"
                    class="com.calpano.ddot.actions.ExportJsonAction"
                    text="Export as JSON"
                    description="Export the current ddot.it document as JSONL events to a file next to the source"/>
            <!-- Registered here (not in ddot-asciidoc.xml) so the menu entry
                 is visible regardless of whether the AsciiDoc plugin is
                 installed yet — the action's whole point is to help with
                 setting that up. The action itself checks for the AsciiDoc
                 plugin at runtime. -->
            <action
                    id="Ddot.InstallAsciidocExtension"
                    class="com.calpano.ddot.actions.InstallAsciidocExtensionAction"
                    text="Install AsciiDoc Preview Extension"
                    description="Copy ddot-extension.rb into &lt;contentRoot&gt;/.asciidoctor/lib/ so the AsciiDoc preview renders [ddot] blocks with role coloring."/>
        </group>
    </actions>
</idea-plugin>
